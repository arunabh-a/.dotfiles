# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host hoocup-oracle
    HostName 140.245.27.180
    User ubuntu
    IdentityFile ~/.ssh/keys/hoocup-oracle-private.key
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive yes

Host aws-hoocup
    HostName 35.154.160.169
    User ubuntu
    IdentityFile ~/.ssh/keys/AWS-Hoocup-private.pem
    IdentitiesOnly yes

Host arunabh-aws
    Hostname ec2-13-203-210-19.ap-south-1.compute.amazonaws.com
    User ubuntu
    IdentityFile ~/.ssh/keys/AWS-Arunabh-Key.pem
    IdentitiesOnly yes

Host arunabh-server
    Hostname 192.168.1.10
    User arunabh 
    IdentityFile ~/.ssh/keys/corsver
    IdentitiesOnly yes

